{
  "name": "Liora — Recouvrement",
  "dataColors": [
    "#2a78d6",
    "#eb6834",
    "#1baf7a",
    "#eda100",
    "#e87ba4",
    "#008300",
    "#4a3aa7",
    "#e34948"
  ],
  "good": "#0ca30c",
  "neutral": "#fab219",
  "bad": "#d03b3b",
  "maximum": "#0d366b",
  "center": "#86b6ef",
  "minimum": "#cde2fb",
  "null": "#8b91a5",
  "background": "#FFFFFF",
  "secondaryBackground": "#F4F5F9",
  "tableAccent": "#F47458",
  "foreground": "#0B0E1A",
  "foregroundNeutralSecondary": "#5B6178",
  "foregroundNeutralTertiary": "#8B91A5",
  "textClasses": {
    "title": {
      "fontSize": 13,
      "fontFace": "Segoe UI Semibold",
      "color": "#5B6178"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#5B6178"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#5B6178"
    },
    "callout": {
      "fontSize": 32,
      "fontFace": "Segoe UI Semibold",
      "color": "#0B0E1A"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E4E6ED" } }, "radius": 6 }],
        "dropShadow": [{ "show": false }],
        "visualHeader": [{ "show": true, "background": { "solid": { "color": "#FFFFFF" } } }],
        "title": [{
          "show": true,
          "fontColor": { "solid": { "color": "#5B6178" } },
          "fontSize": 11,
          "fontFamily": "Segoe UI Semibold",
          "alignment": "left"
        }],
        "categoryAxis": [{
          "showAxisTitle": false,
          "labelColor": { "solid": { "color": "#5B6178" } },
          "fontSize": 10,
          "gridlineShow": false,
          "lineColor": { "solid": { "color": "#C9CCD6" } }
        }],
        "valueAxis": [{
          "showAxisTitle": false,
          "labelColor": { "solid": { "color": "#8B91A5" } },
          "fontSize": 10,
          "gridlineShow": true,
          "gridlineColor": { "solid": { "color": "#EDEEF3" } },
          "gridlineThickness": 1,
          "gridlineStyle": "solid"
        }],
        "legend": [{
          "show": true,
          "position": "TopLeft",
          "showTitle": false,
          "labelColor": { "solid": { "color": "#5B6178" } },
          "fontSize": 10
        }],
        "labels": [{
          "show": false,
          "color": { "solid": { "color": "#0B0E1A" } },
          "fontSize": 10,
          "fontFamily": "Segoe UI Semibold"
        }]
      }
    },
    "card": {
      "*": {
        "labels": [{
          "color": { "solid": { "color": "#0B0E1A" } },
          "fontSize": 30,
          "fontFamily": "Segoe UI Semibold"
        }],
        "categoryLabels": [{
          "show": true,
          "color": { "solid": { "color": "#5B6178" } },
          "fontSize": 10,
          "fontFamily": "Segoe UI Semibold"
        }]
      }
    },
    "slicer": {
      "*": {
        "header": [{
          "show": true,
          "fontColor": { "solid": { "color": "#5B6178" } },
          "fontSize": 10,
          "fontFamily": "Segoe UI Semibold",
          "outline": "None"
        }],
        "items": [{
          "fontColor": { "solid": { "color": "#0B0E1A" } },
          "fontSize": 11,
          "background": { "solid": { "color": "#FAFBFD" } }
        }],
        "selection": [{ "singleSelect": false, "strictSingleSelect": false }]
      }
    },
    "tableEx": {
      "*": {
        "grid": [{
          "gridVertical": false,
          "gridHorizontal": true,
          "gridHorizontalColor": { "solid": { "color": "#EDEEF3" } },
          "rowPadding": 4,
          "outlineColor": { "solid": { "color": "#E4E6ED" } }
        }],
        "columnHeaders": [{
          "fontColor": { "solid": { "color": "#5B6178" } },
          "backColor": { "solid": { "color": "#FFFFFF" } },
          "fontSize": 10,
          "fontFamily": "Segoe UI Semibold"
        }],
        "values": [{ "fontSize": 10, "fontColor": { "solid": { "color": "#0B0E1A" } } }]
      }
    },
    "pivotTable": {
      "*": {
        "grid": [{
          "gridVertical": false,
          "gridHorizontal": true,
          "gridHorizontalColor": { "solid": { "color": "#EDEEF3" } },
          "rowPadding": 4
        }],
        "columnHeaders": [{
          "fontColor": { "solid": { "color": "#5B6178" } },
          "backColor": { "solid": { "color": "#FFFFFF" } },
          "fontSize": 10,
          "fontFamily": "Segoe UI Semibold"
        }],
        "subTotals": [{ "rowSubtotals": true, "columnSubtotals": true }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F4F5F9" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#F4F5F9" } } }]
      }
    }
  }
}
